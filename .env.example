# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database (docker compose: postgres) ─────────────────
DATABASE_URL=postgres://kampora:kampora@127.0.0.1:5433/kampora

# ── Queue (docker compose: redis) ───────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Storage ─────────────────────────────────────────────
# local→ files under STORAGE_LOCAL_ROOT, served by the API with HMAC-signed URLs (default for dev)
# s3   → AWS S3 in production, or any S3-compatible endpoint (set S3_ENDPOINT)
STORAGE_DRIVER=local
S3_BUCKET=kampora-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Relative paths resolve against the repo root.
STORAGE_LOCAL_ROOT=.data/storage
MEDIA_SIGNING_SECRET=change-me-dev-only-signing-secret
API_PUBLIC_URL=http://localhost:4000

# ── API ─────────────────────────────────────────────────
API_PORT=4000
# Dev-only auth: this bearer token maps to the seeded demo user. Refused when NODE_ENV=production.
DEV_API_TOKEN=dev-kampora-token
WEB_ORIGIN=http://localhost:3000

# ── Web (server-side only; never exposed to the browser) ─
KAMPORA_API_URL=http://localhost:4000
KAMPORA_API_TOKEN=dev-kampora-token

# ── Worker ──────────────────────────────────────────────
RENDER_CONCURRENCY=1
# Remotion's own render concurrency (browser tabs). Lower it on small machines.
REMOTION_CONCURRENCY=2
MAX_ASSET_BYTES=104857600

# ── Cost control ────────────────────────────────────────
# Paid providers are NEVER called unless this is "true" AND the production plan is approved.
KAMPORA_ALLOW_PAID_GENERATION=false
PROJECT_MAX_BUDGET_USD=5
PER_GENERATION_MAX_USD=1
MAX_GENERATION_ATTEMPTS=2
MAX_CONCURRENT_PAID_GENERATIONS=2
# Optional JSON price catalog with verified provider prices (see docs/COST_MODEL.md)
KAMPORA_PRICE_CATALOG_PATH=

# ── AI providers (optional; mock providers are used when unset) ─
CREATIVE_PROVIDER=mock
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
# Directory with authorized narration files named <sceneKey>.wav|mp3 (TTS_PROVIDER=supplied)
SUPPLIED_NARRATION_DIR=

# Optional: explicit browser for Remotion (needed when node_modules is deeper than Windows MAX_PATH allows)
REMOTION_BROWSER_EXECUTABLE=
