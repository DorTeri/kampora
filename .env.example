# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database (docker compose: postgres) ─────────────────
DATABASE_URL=postgres://kampora:kampora@127.0.0.1:5433/kampora

# ── Queue (docker compose: redis) ───────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Storage ─────────────────────────────────────────────
# local→ files under STORAGE_LOCAL_ROOT, served by the API with HMAC-signed URLs (default for dev)
# s3   → AWS S3 in production, or any S3-compatible endpoint (set S3_ENDPOINT)
STORAGE_DRIVER=local
S3_BUCKET=kampora-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Relative paths resolve against the repo root.
STORAGE_LOCAL_ROOT=.data/storage
MEDIA_SIGNING_SECRET=change-me-dev-only-signing-secret
API_PUBLIC_URL=http://localhost:4000

# ── API ─────────────────────────────────────────────────
API_PORT=4000
# Dev-only auth: this bearer token maps to the seeded demo user. Refused when NODE_ENV=production.
DEV_API_TOKEN=dev-kampora-token
WEB_ORIGIN=http://localhost:3000

# ── Web (server-side only; never exposed to the browser) ─
KAMPORA_API_URL=http://localhost:4000
KAMPORA_API_TOKEN=dev-kampora-token

# ── Worker ──────────────────────────────────────────────
RENDER_CONCURRENCY=1
# Remotion's own render concurrency (browser tabs). Lower it on small machines.
REMOTION_CONCURRENCY=2
MAX_ASSET_BYTES=104857600

# ── Cost control ────────────────────────────────────────
# Paid providers are NEVER called unless this is "true" AND the production plan is approved.
KAMPORA_ALLOW_PAID_GENERATION=false
PROJECT_MAX_BUDGET_USD=5
PER_GENERATION_MAX_USD=1
MAX_GENERATION_ATTEMPTS=2
MAX_CONCURRENT_PAID_GENERATIONS=2
# Optional JSON price catalog with verified provider prices (see docs/COST_MODEL.md)
KAMPORA_PRICE_CATALOG_PATH=

# ── AI providers ─────────────────────────────────────────
# Mock providers are the default: no keys, no cost, deterministic. Paid providers additionally require
# KAMPORA_ALLOW_PAID_GENERATION=true AND an explicit customer approval per operation.
#
# Creative copy (concepts, scripts, storyboards): mock | openai
CREATIVE_PROVIDER=mock
OPENAI_API_KEY=
# Must have a price entry in the catalog (packages/cost-engine/src/catalog.ts) or the provider is disabled.
OPENAI_MODEL=gpt-6.1-terra
OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TIMEOUT_MS=90000
# Optional; only sent when set (not every model accepts it): minimal | low | medium | high
OPENAI_REASONING_EFFORT=
#
# Narration: mock | elevenlabs | supplied | none
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
# Hebrew-capable models only: eleven_v3 | eleven_v4 | eleven_v4_turbo
ELEVENLABS_MODEL_ID=eleven_v3
# Voices offered to customers: "voiceId|Label|female|model;voiceId2|Label 2|male" (model optional)
ELEVENLABS_VOICES=
ELEVENLABS_TIMEOUT_MS=60000
# Delivery audio tags ([excited]…) and selective niqqud stay OFF until listening tests show they help.
ELEVENLABS_AUDIO_TAGS=false
HEBREW_SELECTIVE_NIQQUD=false
# Directory with authorized narration files named <sceneKey>.wav|mp3 (TTS_PROVIDER=supplied)
SUPPLIED_NARRATION_DIR=
# ffprobe for measuring narration (defaults to `ffprobe` on PATH)
FFPROBE_PATH=
# Customer-facing ₪ display of USD estimates
DISPLAY_USD_TO_ILS=3.7

# Optional: explicit browser for Remotion (needed when node_modules is deeper than Windows MAX_PATH allows)
REMOTION_BROWSER_EXECUTABLE=
